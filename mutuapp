<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>UNI2 - Mutual Escolar CET 3</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Montserrat',sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
    linear-gradient(
        135deg,
        rgba(255, 23, 69, 0.329),
        rgba(45, 71, 185, 0.514),
        rgba(29, 185, 84, 0.404),
        rgba(247, 165, 0, 0.445)
    ),
    #ffffff;
    color:#141414;
    overflow-x:hidden;
}

/* =========================
   NAVBAR
========================= */

nav{
    width:100%;
    padding:16px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:fixed;
    top:0;
    z-index:1000;
    backdrop-filter:blur(14px);
    background:rgba(255,255,255,0.82);
    border-bottom:1px solid rgba(0,0,0,0.08);
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo img{
    width:96px;
    height:96px;
    object-fit:contain;
}

.logo h2{
    font-size:30px;
    font-weight:800;
}

.nav-links{
    display:flex;
    align-items:center;
    gap:30px;
}

.nav-links a{
    text-decoration:none;
    color:#333333;
    font-weight:500;
    transition:0.3s;
}

.nav-links a:hover{
    color:#1db954;
}

.login-btn{
    padding:13px 24px;
    border:none;
    border-radius:50px;
    background:linear-gradient(135deg,#1db954,#159643);
    color:white;
    font-weight:700;
    cursor:pointer;
    transition:0.3s;
}

.login-btn:hover{
    transform:translateY(-3px);
}

/* =========================
   HERO
========================= */

.hero{
    min-height:90vh;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:60px;
    padding:140px 8% 70px;
    position:relative;
    overflow:hidden;
}

.hero::before{
    content:"";
    position:absolute;
    width:700px;
    height:700px;
    background:
    radial-gradient(circle,
    rgba(29,185,84,0.20),
    transparent 70%);
    top:-250px;
    right:-250px;
}

.hero::after{
    content:"";
    position:absolute;
    width:500px;
    height:500px;
    background:
    radial-gradient(circle,
    rgba(255,23,68,0.18),
    transparent 70%);
    bottom:-200px;
    left:-200px;
}

/* HERO TEXT */

.hero-text{
    width:58%;
    z-index:2;
}

.hero-text span{
    color:#f7a400;
    font-size:14px;
    font-weight:800;
    letter-spacing:2px;
}

.hero-text h1{
    font-size:76px;
    line-height:1.05;
    margin:20px 0;
    font-weight:800;
}

.hero-text p{
    color:#333333;
    font-size:20px;
    line-height:1.8;
    max-width:700px;
    margin-bottom:35px;
}

/* BUTTONS */

.hero-buttons{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
}

.primary-btn{
    display:inline-block;
    padding:16px 30px;
    border:none;
    border-radius:50px;
    background:
    linear-gradient(135deg,#1db954,#149443);

    color:white;
    font-size:16px;
    font-weight:700;
    text-decoration:none;
    cursor:pointer;
    transition:0.3s;
}

.primary-btn:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 25px rgba(29,185,84,0.3);
}

.secondary-btn{
    display:inline-block;
    padding:16px 30px;
    border-radius:50px;
    border:2px solid #2d46b9;
    background:transparent;
    color:#2d46b9;
    font-size:16px;
    font-weight:700;
    text-decoration:none;
    cursor:pointer;
    transition:0.3s;
}

.secondary-btn:hover{
    background:#2d46b9;
    color:white;
}

/* HERO CARD */

.hero-card{
    width:360px;

    background:
    linear-gradient(180deg,#ffffff,#f5f5f5);

    padding:35px;
    border-radius:30px;

    border:1px solid rgba(0,0,0,0.08);

    box-shadow:
    0 15px 40px rgba(0,0,0,0.14);

    z-index:2;
}

.hero-card h3{
    font-size:30px;
    margin-bottom:15px;
}

.hero-card p{
    color:#444444;
    line-height:1.7;
    margin-bottom:25px;
}

.card-benefit{
    background:#ffffff;
    padding:18px;
    border-radius:18px;
    margin-bottom:15px;
    transition:0.3s;
}

.card-benefit:hover{
    transform:translateX(6px);
    background:#f1f7ff;
}

.card-benefit h4{
    color:#1db954;
    margin-bottom:6px;
}

/* =========================
   BENEFICIOS DESTACADOS
========================= */

.featured{
    padding:20px 8% 100px;
}

.featured-header{
    display:flex;
    justify-content:space-between;
    align-items:end;
    margin-bottom:35px;
    gap:30px;
}

.featured-subtitle{
    color:#f7a400;
    font-size:13px;
    font-weight:800;
    letter-spacing:2px;
}

.featured-header h2{
    font-size:52px;
    margin-top:10px;
}

.featured-header p{
    color:#333333;
    max-width:420px;
    line-height:1.7;
}

/* SLIDER */

.slider{
    display:flex;
    gap:25px;
    overflow-x:auto;
    scroll-behavior:smooth;
    padding-bottom:10px;
}

.slider::-webkit-scrollbar{
    height:8px;
}

.slider::-webkit-scrollbar-thumb{
    background:#1db954;
    border-radius:20px;
}

/* SLIDES */

.slide{
    min-width:380px;
    height:260px;
    border-radius:32px;
    padding:35px;
    position:relative;
    overflow:hidden;
    flex-shrink:0;
    transition:0.35s;
    cursor:pointer;

    display:flex;
    align-items:flex-end;

    box-shadow:
    0 10px 30px rgba(0,0,0,0.35);
}

.slide:hover{
    transform:translateY(-10px) scale(1.02);
}

.slide::before{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    background:rgba(255,255,255,0.08);
    border-radius:50%;
    top:-120px;
    right:-80px;
}

.slide-overlay{
    position:absolute;
    inset:0;
    background:
    linear-gradient(
        to top,
        rgba(0,0,0,0.35),
        transparent
    );
}

/* COLORES */

.green{
    background:
    linear-gradient(135deg,#1db954,#0d7a36);
}

.red{
    background:
    linear-gradient(135deg,#ff1744,#b2102f);
}

.blue{
    background:
    linear-gradient(135deg,#2d46b9,#1d2f7f);
}

.orange{
    background:
    linear-gradient(135deg,#f7a400,#d17d00);
}

/* CONTENT */

.slide-content{
    position:relative;
    z-index:2;
}

.tag{
    font-size:13px;
    font-weight:800;
    letter-spacing:1px;
}

.slide-content h3{
    font-size:38px;
    line-height:1.1;
    margin:14px 0;
    font-weight:800;
}

.slide-content p{
    font-size:15px;
    line-height:1.7;
    max-width:280px;
    color:#f0f0f0;
    margin-bottom:20px;
}

.slide-content button{
    padding:12px 22px;
    border:none;
    border-radius:40px;
    background:white;
    color:black;
    font-weight:700;
    cursor:pointer;
    transition:0.3s;
}

.slide-content button:hover{
    transform:scale(1.05);
}

/* =========================
   TIENDAS DISPONIBLES
========================= */

.stores{
    padding:30px 8% 130px;
    min-height:620px;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
}

.stores h2{
    font-size:52px;
    max-width:560px;
    text-align:center;
    position:relative;
    z-index:3;
    margin:auto;
    transition:0.35s;
    cursor:default;
    text-shadow:0 6px 18px rgba(255,255,255,0.65);
}

.stores h2:hover{
    transform:translateY(-6px) scale(1.03);
    letter-spacing:1px;
}

.floating-photos{
    position:absolute;
    inset:0;
}

.floating-photo{
    width:230px;
    height:170px;
    border-radius:24px;
    overflow:hidden;
    position:absolute;
    background-size:cover;
    background-position:center;
    box-shadow:0 16px 35px rgba(0,0,0,0.25);
    transition:0.35s;
}

.floating-photo:hover{
    transform:scale(1.08);
    z-index:5;
}

.floating-photo::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(
        to top,
        rgba(0,0,0,0.68),
        rgba(0,0,0,0.08)
    );
}

.floating-photo div{
    position:relative;
    z-index:2;
    color:white;
    height:100%;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    padding:20px;
}

.floating-photo span{
    font-size:13px;
    font-weight:800;
    letter-spacing:1px;
}

.floating-photo h3{
    font-size:24px;
    margin-top:6px;
}

.photo-1{
    top:25px;
    left:6%;
    background-image:url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=900&q=80");
}

.photo-2{
    top:30px;
    right:6%;
    background-image:url("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=900&q=80");
}

.photo-3{
    bottom:35px;
    left:8%;
    background-image:url("https://images.unsplash.com/photo-1612872087720-bb876e2e67d1?auto=format&fit=crop&w=900&q=80");
}

.photo-4{
    bottom:35px;
    right:8%;
    background-image:url("https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=900&q=80");
}

.photo-5{
    top:240px;
    left:1%;
    width:190px;
    height:145px;
    background-image:url("https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=900&q=80");
}

.photo-6{
    top:240px;
    right:1%;
    width:190px;
    height:145px;
    background-image:url("https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=80");
}

/* =========================
   FORMULARIO DE ASOCIACION
========================= */

.associate-section{
    position:fixed;
    inset:0;
    padding:40px 20px;
    display:none;
    align-items:center;
    justify-content:center;
    background:rgba(0,0,0,0.48);
    backdrop-filter:blur(8px);
    z-index:2000;
    overflow-y:auto;
}

.associate-section.is-open{
    display:flex;
}

.associate-card{
    width:100%;
    max-width:780px;
    background:white;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 16px 40px rgba(0,0,0,0.22);
    animation:modalIn 0.35s ease;
}

@keyframes modalIn{
    from{
        opacity:0;
        transform:translateY(30px) scale(0.96);
    }

    to{
        opacity:1;
        transform:translateY(0) scale(1);
    }
}

.associate-header{
    background:linear-gradient(90deg,#1db954,#2d46b9,#ff1744);
    color:white;
    padding:35px;
    text-align:center;
    position:relative;
}

.associate-header h2{
    font-size:42px;
    margin-bottom:10px;
}

.associate-header p{
    font-size:16px;
    opacity:0.92;
}

.close-associate{
    position:absolute;
    top:18px;
    right:18px;
    width:38px;
    height:38px;
    border:none;
    border-radius:50%;
    background:rgba(255,255,255,0.2);
    color:white;
    font-size:26px;
    line-height:1;
    cursor:pointer;
    transition:0.3s;
}

.close-associate:hover{
    background:white;
    color:#2d46b9;
    transform:rotate(90deg);
}

.associate-form{
    padding:35px;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.form-group{
    margin-bottom:22px;
}

.form-group label{
    display:block;
    margin-bottom:8px;
    font-weight:700;
    color:#333333;
}

.form-group input,
.form-group select{
    width:100%;
    padding:14px;
    border:2px solid #d9d9d9;
    border-radius:12px;
    font-size:15px;
    transition:0.3s;
}

.form-group input:focus,
.form-group select:focus{
    border-color:#1db954;
    outline:none;
}

.radio-group{
    display:flex;
    gap:20px;
    margin-top:10px;
}

.radio-item{
    display:flex;
    align-items:center;
    gap:8px;
}

.radio-item input{
    width:auto;
}

.associate-submit{
    width:100%;
    padding:16px;
    border:none;
    border-radius:14px;
    background:linear-gradient(135deg,#1db954,#2d46b9);
    color:white;
    font-size:18px;
    font-weight:800;
    cursor:pointer;
    transition:0.3s;
}

.associate-submit:hover{
    transform:scale(1.02);
    box-shadow:0 10px 25px rgba(45,70,185,0.25);
}

.associate-footer{
    text-align:center;
    padding:20px;
    color:#666666;
    font-size:14px;
}

.thanks-message{
    position:fixed;
    inset:0;
    display:none;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:20px;
    background:rgba(255,255,255,0.9);
    z-index:2100;
}

.thanks-message.is-visible{
    display:flex;
}

.thanks-message h2{
    font-size:46px;
    max-width:760px;
    line-height:1.2;
    color:#141414;
    animation:thanksIn 0.5s ease;
}

@keyframes thanksIn{
    from{
        opacity:0;
        transform:scale(0.9);
    }

    to{
        opacity:1;
        transform:scale(1);
    }
}

.confetti-piece{
    position:fixed;
    top:-20px;
    width:10px;
    height:16px;
    border-radius:3px;
    z-index:2200;
    animation:confettiFall 2.8s linear forwards;
}

@keyframes confettiFall{
    to{
        transform:translateY(110vh) rotate(720deg);
        opacity:0;
    }
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1000px){

    .hero{
        flex-direction:column;
        text-align:center;
    }

    .hero-text{
        width:100%;
    }

    .hero-card{
        width:100%;
        max-width:450px;
    }

    .hero-text h1{
        font-size:54px;
    }

    .featured-header{
        flex-direction:column;
        align-items:start;
    }

    .stores{
        min-height:auto;
        display:block;
    }

    .stores h2{
        margin-bottom:28px;
    }

    .floating-photos{
        position:relative;
        display:grid;
        grid-template-columns:repeat(2,1fr);
        gap:18px;
    }

    .floating-photo,
    .photo-5,
    .photo-6{
        position:relative;
        inset:auto;
        width:100%;
        height:190px;
    }

    .form-row{
        grid-template-columns:1fr;
        gap:0;
    }

}

@media(max-width:700px){

    nav{
        padding:20px;
    }

    .nav-links{
        display:none;
    }

    .hero{
        padding:130px 20px 60px;
    }

    .featured{
        padding:20px 20px 70px;
    }

    .stores{
        padding:20px 20px 80px;
    }

    .hero-text h1{
        font-size:42px;
    }

    .featured-header h2,
    .stores h2{
        font-size:38px;
    }

    .slide{
        min-width:320px;
        height:240px;
    }

    .slide-content h3{
        font-size:30px;
    }

    .floating-photos{
        grid-template-columns:1fr;
    }

    .associate-section{
        padding:20px 20px 80px;
    }

    .associate-header h2{
        font-size:32px;
    }

    .associate-form{
        padding:24px;
    }

}

</style>
</head>

<body>

<!-- NAV -->

<nav>

    <div class="logo">
        <img src="UNI2_LOGO.png" alt="UNI2">
        <h2>UNI2</h2>
    </div>

    <div class="nav-links">
