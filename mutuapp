            <h2>UNI2</h2>
            <p>Formulario de Asociación a la Mutual</p>
        </div>

        <form class="associate-form" id="associateForm">

            <div class="form-row">
                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" placeholder="Ingrese su nombre" required>
                </div>

                <div class="form-group">
                    <label>Apellido</label>
                    <input type="text" placeholder="Ingrese su apellido" required>
                </div>
            </div>

            <div class="form-group">
                <label>Correo Gmail</label>
                <input type="email" placeholder="ejemplo@gmail.com" required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Meses que desea asociarse</label>
                    <select required>
                        <option value="">Seleccione una opción</option>
                        <option>1 Mes</option>
                        <option>3 Meses</option>
                        <option>6 Meses</option>
                        <option>12 Meses</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Fecha de asociación</label>
                    <input type="date" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Año</label>
                    <select required>
                        <option value="">Seleccione</option>
                        <option>1° Año</option>
                        <option>2° Año</option>
                        <option>3° Año</option>
                        <option>4° Año</option>
                        <option>5° Año</option>
                        <option>6° Año</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Curso</label>
                    <input type="text" placeholder="Ej: A, B, C..." required>
                </div>
            </div>

            <div class="form-group">
                <label>¿Es parte de la escuela?</label>

                <div class="radio-group">
                    <div class="radio-item">
                        <input type="radio" name="escuela" required>
                        <span>Sí</span>
                    </div>

                    <div class="radio-item">
                        <input type="radio" name="escuela">
                        <span>No</span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Si no pertenece, ¿de cuál escuela es?</label>
                <input type="text" placeholder="Nombre de la escuela">
            </div>

            <div class="form-group">
                <label>¿Es docente?</label>

                <div class="radio-group">
                    <div class="radio-item">
                        <input type="radio" name="docente" required>
                        <span>Sí</span>
                    </div>

                    <div class="radio-item">
                        <input type="radio" name="docente">
                        <span>No</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="associate-submit">
                Asociarme a UNI2
            </button>

        </form>

        <div class="associate-footer">
            UNI2 - Mutual Escolar
        </div>

    </div>

</section>

<div class="thanks-message" id="thanksMessage">
    <h2>
        Muchas gracias por ser parte de la mutual
    </h2>
</div>

<script>
    const openAssociate = document.getElementById("openAssociate");
    const closeAssociate = document.getElementById("closeAssociate");
    const associateModal = document.getElementById("asociarme");
    const associateForm = document.getElementById("associateForm");
    const thanksMessage = document.getElementById("thanksMessage");

    function openAssociateModal(event){
        event.preventDefault();
        associateModal.classList.add("is-open");
        document.body.style.overflow = "hidden";
    }

    function closeAssociateModal(){
        associateModal.classList.remove("is-open");
        document.body.style.overflow = "";
    }

    function launchConfetti(){
        const colors = ["#1db954", "#2d46b9", "#ff1744", "#f7a400", "#ffffff"];

        for(let i = 0; i < 90; i++){
            const confetti = document.createElement("span");
            confetti.className = "confetti-piece";
            confetti.style.left = Math.random() * 100 + "vw";
            confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
            confetti.style.animationDelay = Math.random() * 0.7 + "s";
            confetti.style.transform = "rotate(" + Math.random() * 360 + "deg)";
            document.body.appendChild(confetti);

            setTimeout(() => {
                confetti.remove();
            }, 3600);
        }
    }

    openAssociate.addEventListener("click", openAssociateModal);
    closeAssociate.addEventListener("click", closeAssociateModal);

    associateModal.addEventListener("click", (event) => {
        if(event.target === associateModal){
            closeAssociateModal();
        }
    });

    associateForm.addEventListener("submit", (event) => {
        event.preventDefault();
        closeAssociateModal();
        associateForm.reset();
        thanksMessage.classList.add("is-visible");
        launchConfetti();

        setTimeout(() => {
            thanksMessage.classList.remove("is-visible");
        }, 4200);
    });
</script>

</body>
</html>
